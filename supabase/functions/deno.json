{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "check": "deno check create-upload/index.ts confirm-upload/index.ts photo/index.ts cleanup-expired/index.ts integration/photo_delivery_integration_test.ts",
    "test": "deno test tests",
    "test:integration": "deno test --allow-env --allow-net integration/photo_delivery_integration_test.ts"
  }
}
